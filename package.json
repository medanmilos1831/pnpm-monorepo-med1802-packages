{
    "name": "pnpm-monorepo",
    "private": true,
    "version": "1.0.0",
    "workspaces": [
        "med1802/*"
    ],
    "devDependencies": {
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.0.11",
        "typescript": "^5.8.3"
    },
    "dependencies": {
        "react": "^18.3.1"
    },
    "scripts": {
        "build:med1802-scoped-observer": "pnpm --filter @med1802/scoped-observer run build",
        "publish:med1802-scoped-observer": "pnpm publish --filter @med1802/scoped-observer --access public",
        "build:med1802-scoped-observer-vue": "pnpm --filter @med1802/scoped-observer-vue run build",
        "publish:med1802-scoped-observer-vue": "pnpm publish --filter @med1802/scoped-observer-vue --access public",
        "build:med1802-scoped-observer-react": "pnpm --filter @med1802/scoped-observer-react run build",
        "publish:med1802-scoped-observer-react": "pnpm publish --filter @med1802/scoped-observer-react --access public",
        "build:med1802-filter-vue": "pnpm --filter @med1802/filter-vue run build",
        "publish:med1802-filter-vue": "pnpm publish --filter @med1802/filter-vue --access public",
        "build:med1802-scroll-vue": "pnpm --filter @med1802/scroll-vue run build",
        "publish:med1802-scroll-vue": "pnpm publish --filter @med1802/scroll-vue --access public",
        "build:med1802-repository-manager": "pnpm --filter @med1802/repository-manager run build",
        "publish:med1802-repository-manager": "pnpm publish --filter @med1802/repository-manager --access public"
    }
}